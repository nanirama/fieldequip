{
  "crons": [
    {
      "path": "/api/cron/sanity-backup",
      "schedule": "0 2 1 * *"
    }
  ],
  "headers": [
    {
      "source": "/images/(.*\\.(?:webp|avif|png|jpg|jpeg|gif|ico|svg))",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/images/(.*\\.pdf)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/fonts/(.*\\.(?:woff2|woff|ttf|otf|eot))",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
